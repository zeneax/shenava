# ─────────────────────────────────────────────────────────────────────────────
# Shenava — copy this file to .env.local and fill it in.
#
#   cp .env.example .env.local
#
# .env.local is gitignored. Nothing in this file should ever be committed with
# a real value in it.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (required) ──────────────────────────────────────────────────────
# Make a free project at https://supabase.com, then Project Settings → API.
#
# The URL looks like https://abcdefghijklm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# The service_role key. It bypasses Row Level Security, so it is server-only:
# it must never appear in a NEXT_PUBLIC_ variable and never reach a browser.
SUPABASE_SERVICE_ROLE_KEY=

# The anon key. Not used by default (every table has RLS on with no policies,
# so this key can read nothing), but filled in for completeness.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── OpenRouter (required) ────────────────────────────────────────────────────
# One key for every model. Get it at https://openrouter.ai/keys and add a few
# dollars of credit — an hour-long meeting costs roughly 20 cents end to end.
#
# Note: below about $1 of remaining credit, OpenRouter starts answering 402 to
# concurrent calls. If transcription suddenly fails on every piece, check the
# balance before anything else.
OPENROUTER_API_KEY=

# Sent to OpenRouter as the referring app, which is how it labels your usage.
# Anything is fine.
OPENROUTER_APP_NAME=Shenava
OPENROUTER_APP_URL=http://localhost:3000

# ── The door (optional — leave EMPTY on your own machine) ────────────────────
# Empty means there is no login at all. That is right for localhost: the only
# person who can open the page is the person sitting at the machine.
#
# SET IT BEFORE YOU DEPLOY THIS ANYWHERE PUBLIC. A public deployment carries
# YOUR OpenRouter key, and anyone who opens the record page is spending your
# money.
APP_PASSWORD=

# A random string used to sign the session cookie. Required only if
# APP_PASSWORD is set. Generate one with:  openssl rand -hex 32
APP_SESSION_SECRET=
